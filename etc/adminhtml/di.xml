<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Ui\Model\Export\MetadataProvider">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="mavenbird_blog_post_listing" xsi:type="array">
                    <item name="created_at" xsi:type="string">created_at</item>
                    <item name="updated_at" xsi:type="string">updated_at</item>
                    <item name="publish_date" xsi:type="string">publish_date</item>
                </item>
                <item name="mavenbird_blog_tag_listing" xsi:type="array">
                    <item name="created_at" xsi:type="string">created_at</item>
                    <item name="updated_at" xsi:type="string">updated_at</item>
                </item>
                <item name="mavenbird_blog_topic_listing" xsi:type="array">
                    <item name="created_at" xsi:type="string">created_at</item>
                    <item name="updated_at" xsi:type="string">updated_at</item>
                </item>
                <item name="mavenbird_blog_comment_listing" xsi:type="array">
                    <item name="created_at" xsi:type="string">created_at</item>
                </item>
                <item name="mavenbird_blog_author_listing" xsi:type="array">
                    <item name="created_at" xsi:type="string">created_at</item>
                    <item name="updated_at" xsi:type="string">updated_at</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Catalog\Model\ResourceModel\Product\Collection">
        <plugin name="blog-post-product-sort" type="Mavenbird\Blog\Plugin\Catalog\AttributeSort"/>
    </type>
    <!-- update banner in config infomation tab -->
    <type name="Mavenbird\Blog\Block\Adminhtml\System\Config\Docs">
        <plugin name="blog-config-banner" type="Mavenbird\Blog\Plugin\System\Config\Banner"/>
    </type>
</config>
