<?php 
/**
 * @var $block Mavenbird\Blog\Block\Sidebar\TableOfContent
 */
?>
<?php if ($block->canShowTableOfContent()): ?>
<div class="block-contents sidebar-info<?= $block->isStickyTableOfContent() ? ' sticky' : '' ?>" id="toc-block">	
    <div class="block-title sidebar-tags">
        <p class="block-title-sidebar-heading" role="heading" aria-level="2">
            <strong><?= $block->escapeHtml(__('Table of Contents')) ?></strong>
        </p>
    </div>
	<div class="blog-content-nav">
		<ul id="toc-list"></ul>
	</div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const tocBlock = document.getElementById("toc-block");
    const tocList = document.getElementById("toc-list");
    const headings = document.querySelectorAll(".post-view h2, .post-view h3");

    // Remove block if no headings
    if (!headings.length) {
        tocBlock.remove();
        return;
    }

    // Build TOC
    headings.forEach((heading, index) => {
        if (!heading.id) {
            heading.id = "section-" + index;
        }
        const tagName = heading.tagName.toLowerCase();
        const sectionText = heading.textContent;
        const sectionId = heading.id;
        const listItemClass = tagName === "h2" ? "toc-h2" : "toc-h3";

        const li = document.createElement("li");
        li.className = listItemClass;

        const a = document.createElement("a");
        a.href = "#" + sectionId;
        a.textContent = sectionText;

        li.appendChild(a);
        tocList.appendChild(li);
    });

    // Smooth scrolling
    tocList.querySelectorAll("li a").forEach(link => {
        link.addEventListener("click", function (event) {
            event.preventDefault();
            const target = document.querySelector(this.getAttribute("href"));
            if (target) {
                window.scrollTo({
                    top: target.offsetTop - 80,
                    behavior: "smooth"
                });
            }
        });
    });

    // Scroll spy
    window.addEventListener("scroll", function () {
        const scrollPosition = window.scrollY;
        headings.forEach((heading, index) => {
            const sectionTop = heading.offsetTop - 120;
            const sectionBottom = sectionTop + heading.offsetHeight;

            if (scrollPosition >= sectionTop && scrollPosition < sectionBottom) {
                document.querySelectorAll("#toc-list li").forEach(li => li.classList.remove("active"));
                document.querySelectorAll("#toc-list li")[index]?.classList.add("active");
            }
        });
    });
});
</script>
<?php endif; ?>