use Mavenbird\Blog\Block\Tag\Widget;
use Magento\Framework\Escaper;

/** @var Widget $block */
/** @var Escaper $escaper */
$tags = $block->getTagList();

if ($tags && $tags->getSize()) : ?>
<div class="sidebar-info ">
    <div class="block-title sidebar-tags">
        <p class="block-title-sidebar-heading" role="heading" aria-level="2">
            <strong><?= $escaper->escapeHtml(__('Tags')) ?></strong>
        </p>
    </div>
    <div class="tags">
        <?php foreach ($tags as $tag) :
            $size = $block->getTagSize($tag);
        ?>
        <a class="label label-default tags-list"
        style="font-size:<?= $escaper->escapeHtmlAttr($size) ?>px"
        href="<?= $escaper->escapeUrl($block->getTagUrl($tag)) ?>">
        <?= $escaper->escapeHtml($tag->getName()) ?>
        </a>
        <?php endforeach; ?>
    </div>
</div>
<?php endif; ?>