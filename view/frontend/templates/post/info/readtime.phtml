use Mavenbird\Blog\Block\Post\View;
use Mavenbird\Blog\Helper\Image;
use Mavenbird\Blog\Model\Config\Source\Comments\Type;
use Magento\Framework\Escaper;

/** @var View $block */
/** @var Escaper $escaper */
$_post = $block->getPost();
// Calculate read time
$postContent = strip_tags($_post->getPostContent());
$wordCount = str_word_count($postContent);
$wordsPerMinute = 200; // Average reading speed
$readTime = max(1, ceil($wordCount / $wordsPerMinute));
?>
<?php if ($categoryHtml = $block->getPostCategoryHtml($_post)) : ?>
    |
    <span>
        <i class="fa fa-clock-o"></i>
        <?= $escaper->escapeHtml(__('%1 min read', $readTime)); ?>
    </span>
<?php endif; ?>
