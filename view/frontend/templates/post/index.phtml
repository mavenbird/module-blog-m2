                <?php /* if ($block->isHyvaTheme()): */ ?>
                <?php if (true): ?>
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        const splideElement = document.getElementById('featured-authors-splide');
                        if (splideElement) {
                            new Splide('#featured-authors-splide', {
                                type: 'slide',
                                perPage: 2,
                                perMove: 1,
                                gap: '24px',
                                loop: false,
                                pagination: true,
                                arrows: true,
                                breakpoints: {
                                    768: {
                                        perPage: 1,
                                        gap: '16px'
                                    }
                                }
                            }).mount();
                        }
                    });
                </script>
                <?php else: ?>
                <script>
                    require(['jquery', 'owlCarousel'], function($) {
                        $(function() {
                            if ($('.blog-authors-slider').length) {
                                $('.blog-authors-slider').owlCarousel({
                                    loop: true,
                                    margin: 24,
                                    nav: true,
                                    dots: true,
                                    responsive: {
                                        0: {
                                            items: 1
                                        },
                                        768: {
                                            items: 2
                                        }
                                    }
                                });
                            }
                        });
                    });
                </script>
                <?php endif; ?>
            <?php endif; ?>
        <?php endif; ?>

    <?php else : ?>
        <div class="blog-empty-state">
            <?= $escaper->escapeHtml(__('There are no posts at this moment')) ?>
        </div>
    <?php endif; ?>

    <?= $block->getChildHtml('additional'); ?>
</div>

