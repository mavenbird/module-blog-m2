                            <div class="details-sharing">
                                <div id="sharing">
                                    <div class="share-col-left">
                                        <h5><?= $escaper->escapeHtml(__('Share this post')) ?></h5>
                                    </div>
                                    <div class="share-col-right">
                                        <div class="post-sharing-button">
