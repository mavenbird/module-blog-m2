                                                        rel="noopener"
                                                        title="<?= $escaper->escapeHtmlAttr($share['label']) ?>">

                                                        <i class="<?= $escaper->escapeHtmlAttr($share['icon_class']) ?>
                                                                <?= $escaper->escapeHtmlAttr($share['icon']) ?>"></i>

                                                    </a>
                                                <?php endif; ?>
