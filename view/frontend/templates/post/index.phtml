    <?php if ($postCollection && $postCollection->getSize()) : ?>
        <?php
        $posts = [];
        foreach ($postCollection as $postItem) {
            $posts[] = $postItem;
        }

        $recommendCount = (int) $block->getRecommendCount();
        $recommendCount = $recommendCount > 0 ? $recommendCount : 3;

        $recommendedPosts = array_slice($posts, 0, $recommendCount);
        $heroPost = $recommendedPosts[0] ?? null;
        // Take remaining posts for mini grid - show all remaining in a responsive grid
        $miniPosts = array_slice($recommendedPosts, 1);
        ?>

        <section class="blog-recommended">
            <h2 class="blog-section-heading">
                <?= $escaper->escapeHtml(__('Recommended Posts')) ?>
            </h2>

            <?php if ($heroPost) : ?>
                <article class="blog-hero-card">
                    <a class="blog-hero-media" href="<?= $escaper->escapeUrl($heroPost->getUrl()) ?>">
                        <img
                            class="blog-hero-image"
                            src="<?= $escaper->escapeUrl($block->resizeImage($heroPost->getImage(), '1000x')) ?>"
                            alt="<?= $escaper->escapeHtmlAttr($heroPost->getName()) ?>"
                        />
                    </a>

                    <div class="blog-content">
                        <h3 class="blog-title">
                            <a class="post-link-title"
                               href="<?= $escaper->escapeUrl($heroPost->getUrl()) ?>"
                               title="<?= $escaper->escapeHtmlAttr($heroPost->getName()) ?>">
                                <?= $escaper->escapeHtml($heroPost->getName()) ?>
                            </a>
                        </h3>

                        <div class="blog-readtime-date">
                            <?=
                            /** @noEscape */
                            $block->getstyle2PostInfo($heroPost)
                            ?>
                        </div>
                    </div>
                </article>
            <?php endif; ?>

            <?php if (!empty($miniPosts)) : ?>
                <div class="blog-mini-grid">
                    <?php foreach ($miniPosts as $post) : ?>
                        <article class="blog-mini-card">
                            <?php if ($post->getImage()) : ?>
                                <a class="blog-mini-media" href="<?= $escaper->escapeUrl($post->getUrl()) ?>">
                                    <img
                                        class="blog-image"
                                        src="<?= $escaper->escapeUrl($block->resizeImage($post->getImage(), '1000x')) ?>"
                                        alt="<?= $escaper->escapeHtmlAttr($post->getName()) ?>"
                                    />
                                </a>
                            <?php endif; ?>

                            <div class="blog-content">
                                <h3 class="blog-title">
                                    <a class="post-link-title"
                                       href="<?= $escaper->escapeUrl($post->getUrl()) ?>"
                                       title="<?= $escaper->escapeHtmlAttr($post->getName()) ?>">
                                        <?= $escaper->escapeHtml($post->getName()) ?>
                                    </a>
                                </h3>

                                <div class="blog-readtime-date">
                                    <?=
                                    /** @noEscape */
                                    $block->getstyle2PostInfo($post)
                                    ?>
                                </div>
                            </div>
                        </article>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
        </section>

        <?php $featuredCategories = $block->getFeaturedCategories(); ?>
        <?php if ($featuredCategories) : ?>
            <?php
            $categoryIds = array_values(array_filter(array_map('trim', explode(',', $featuredCategories))));
            $categoryNames = $block->getCategoryNamesByIds($categoryIds);
            ?>

            <?php foreach ($categoryIds as $index => $categoryId) : ?>
                <?php $categoryPosts = $block->getPostsByCategoryIds([$categoryId]); ?>
                <?php if (!$categoryPosts || !$categoryPosts->getSize()) : ?>
                    <?php continue; ?>
                <?php endif; ?>

                <?php
                $categoryArray = [];
                foreach ($categoryPosts as $postItem) {
                    $categoryArray[] = $postItem;
                }

                $categoryTitle = $categoryNames[$index] ?? __('Featured Category');
                $leadPost = $categoryArray[0] ?? null;
                $listPosts = array_slice($categoryArray, 1, 3);
                ?>

                <section class="blog-category-section">
                    <div class="blog-category-header">
                        <h2 class="blog-category-heading">
                            <?= $escaper->escapeHtml($categoryTitle) ?>
                        </h2>

                        <?php $category = $block->helperData->getObjectByParam($categoryId, null, \Mavenbird\Blog\Helper\Data::TYPE_CATEGORY); ?>
                        <a class="blog-category-link" href="<?= $escaper->escapeUrl($block->helperData->getBlogUrl($category, \Mavenbird\Blog\Helper\Data::TYPE_CATEGORY)) ?>">
                            <?= $escaper->escapeHtml(__('See all posts')) ?>
                        </a>
                    </div>

                    <div class="blog-category-grid">
                        <?php if ($leadPost) : ?>
                            <article class="blog-category-feature">
                                <?php if ($leadPost->getImage()) : ?>
                                    <a class="blog-category-feature-media" href="<?= $escaper->escapeUrl($leadPost->getUrl()) ?>">
                                        <img
                                            class="blog-category-feature-image"
                                            src="<?= $escaper->escapeUrl($block->resizeImage($leadPost->getImage(), '1000x')) ?>"
                                            alt="<?= $escaper->escapeHtmlAttr($leadPost->getName()) ?>"
                                        />
                                    </a>
                                <?php endif; ?>

                                <div class="blog-content">
                                    <h3 class="blog-title">
                                        <a class="post-link-title"
                                           href="<?= $escaper->escapeUrl($leadPost->getUrl()) ?>"
                                           title="<?= $escaper->escapeHtmlAttr($leadPost->getName()) ?>">
                                            <?= $escaper->escapeHtml($leadPost->getName()) ?>
                                        </a>
                                    </h3>

                                    <?php if ($block->getShortDescription()) : ?>
                                        <div class="blog-category-feature-desc">
                                            <p>
                                                <?=
                                                /** @noEscape */
                                                $block->maxShortDescription($leadPost->getShortDescription(true))
                                                ?>
                                            </p>
                                        </div>
                                    <?php endif; ?>

                                     <div class="blog-readtime-date">
                                        <?=
                                        /** @noEscape */
                                        $block->getstyle2PostInfo($leadPost)
                                        ?>
                                    </div>
                                </div>
                            </article>
                        <?php endif; ?>

                        <div class="blog-category-list">
                            <?php foreach ($listPosts as $post) : ?>
                                <article class="blog-category-list-item">
                                    <h3 class="blog-title">
                                        <a class="post-link-title"
                                           href="<?= $escaper->escapeUrl($post->getUrl()) ?>"
                                           title="<?= $escaper->escapeHtmlAttr($post->getName()) ?>">
                                            <?= $escaper->escapeHtml($post->getName()) ?>
                                        </a>
                                    </h3>

                                    <div class="blog-readtime-date">
                                        <?=
                                        /** @noEscape */
                                        $block->getstyle2PostInfo($post)
                                        ?>
                                    </div>
                                </article>
                            <?php endforeach; ?>
                        </div>
                    </div>
                </section>
            <?php endforeach; ?>
        <?php endif; ?>

        <?php $authorIds = $block->getAuthorIds(); ?>
        <?php if (!empty($authorIds)) : ?>
            <?php $featuredAuthors = $block->getAuthorsByIds($authorIds); ?>
            <?php if (!empty($featuredAuthors)) : ?>
                <section class="blog-featured-authors">
                    <h2 class="blog-section-heading">
                        <?= $escaper->escapeHtml(__('Featured Authors')) ?>
