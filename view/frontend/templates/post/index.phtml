                                <?= $escaper->escapeHtml($post->getName()) ?>
                            </a>
                        </h2>
                        <div class="mb-post-info">
                            <?=
                            /** @noEscape */
                            $block->getPostInfo($post) ?>
                        </div>
                        <?php if ($block->getShortDescription()) : ?>
                            <div class="post-short-description">
                                <p><?=
                                    /** @noEscape */
                                    $block->maxShortDescription($post->getShortDescription(true)) ?></p>
                            </div>
                        <?php endif; ?>
