                                        src="<?= $escaper->escapeUrl($block->resizeImage($post->getImage(), '1500x')) ?>"
                                        alt="<?= $escaper->escapeHtmlAttr($post->getName()) ?>"
                                    />
                                </a>
                            <?php else : ?>
                                    <div class="post-placeholder">
                                        <a class="blog-category-feature-media" href="<?= $escaper->escapeUrl($post->getUrl()) ?>">
                                            <img
                                                class="blog-category-feature-image"
                                                src="<?= $escaper->escapeUrl($block->getViewFileUrl('Mavenbird_Blog::images/placeholder.jpg')) ?>"
                                                alt="<?= $escaper->escapeHtmlAttr($post->getName()) ?>"
                                            />
                                            <div class="post-name-placeholder"><?= $escaper->escapeHtml($post->getName()) ?></div>
                                        </a>
                                    </div>
                                <?php endif; ?>

                            <div class="blog-content">
                                <h3 class="blog-title">
                                    <a class="post-link-title"
                                       href="<?= $escaper->escapeUrl($post->getUrl()) ?>"
                                       title="<?= $escaper->escapeHtmlAttr($post->getName()) ?>">
                                        <?= $escaper->escapeHtml($post->getName()) ?>
                                    </a>
                                </h3>

                                <div class="blog-readtime-date">
                                    <?=
                                    /** @noEscape */
                                    $block->getPostInfo($post)
                                    ?>
                                </div>
                            </div>
                        </article>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
        </section>

        <?php $preparedFeaturedCategories = $block->getPreparedFeaturedCategories(); ?>
        <?php if ($preparedFeaturedCategories) : ?>
            <?php foreach ($preparedFeaturedCategories as $categoryData) : ?>
