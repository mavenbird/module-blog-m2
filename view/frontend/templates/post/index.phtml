                <?php $categoryPosts = $categoryData['posts']; ?>
                <?php if (!$categoryPosts || !$categoryPosts->getSize()) : ?>
                    <?php continue; ?>
                <?php endif; ?>

                <?php
                $categoryArray = [];
                foreach ($categoryPosts as $postItem) {
                    $categoryArray[] = $postItem;
                }

                $categoryTitle = $category->getName() ?? __('Featured Category');
                $leadPost = $categoryArray[0] ?? null;
                $listPosts = array_slice($categoryArray, 1, 3);
                ?>

                <section class="blog-category-section">
                    <div class="blog-category-header">
                        <h2 class="blog-category-heading">
                            <?= $escaper->escapeHtml($categoryTitle) ?>
                        </h2>

                        <a class="blog-category-link" href="<?= $escaper->escapeUrl($block->helperData->getBlogUrl($category, \Mavenbird\Blog\Helper\Data::TYPE_CATEGORY)) ?>">
                            <?= $escaper->escapeHtml(__('See all posts')) ?>
                        </a>
                    </div>

                    <div class="blog-category-grid">
                        <?php if ($leadPost) : ?>
                            <article class="blog-category-feature">
                                <?php if ($leadPost->getImage()) : ?>
                                    <a class="blog-category-feature-media" href="<?= $escaper->escapeUrl($leadPost->getUrl()) ?>">
                                        <img
                                            class="blog-category-feature-image"
                                            src="<?= $escaper->escapeUrl($block->resizeImage($leadPost->getImage(), '1000x')) ?>"
                                            alt="<?= $escaper->escapeHtmlAttr($leadPost->getName()) ?>"
                                        />
                                    </a>
                                <?php else : ?>
                                    <div class="post-placeholder">
                                        <a class="blog-category-feature-media" href="<?= $escaper->escapeUrl($leadPost->getUrl()) ?>">
                                            <img
                                                class="blog-category-feature-image"
                                                src="<?= $escaper->escapeUrl($block->getViewFileUrl('Mavenbird_Blog::images/placeholder.jpg')) ?>"
                                                alt="<?= $escaper->escapeHtmlAttr($leadPost->getName()) ?>"
                                            />
                                            <div class="post-name-placeholder"><?= $escaper->escapeHtml($post->getName()) ?></div>
                                        </a>
                                    </div>
                                <?php endif; ?>

                                <div class="blog-content">
                                    <h3 class="blog-title">
                                        <a class="post-link-title"
                                           href="<?= $escaper->escapeUrl($leadPost->getUrl()) ?>"
                                           title="<?= $escaper->escapeHtmlAttr($leadPost->getName()) ?>">
                                            <?= $escaper->escapeHtml($leadPost->getName()) ?>
                                        </a>
                                    </h3>

                                    <?php if ($block->getShortDescription()) : ?>
                                        <div class="blog-category-feature-desc">
                                            <p>
                                                <?=
                                                /** @noEscape */
                                                $block->maxShortDescription($leadPost->getShortDescription(true))
                                                ?>
                                            </p>
                                        </div>
                                    <?php endif; ?>

                                     <div class="blog-readtime-date">
                                        <?=
                                        /** @noEscape */
                                        $block->getPostInfo($leadPost)
                                        ?>
                                    </div>
                                </div>
                            </article>
                        <?php endif; ?>

                        <?php foreach ($listPosts as $post) : ?>
                        <div class="blog-category-list">
                                <article class="blog-category-list-item">
                                    <h3 class="blog-title">
                                        <a class="post-link-title"
                                           href="<?= $escaper->escapeUrl($post->getUrl()) ?>"
                                           title="<?= $escaper->escapeHtmlAttr($post->getName()) ?>">
                                            <?= $escaper->escapeHtml($post->getName()) ?>
                                        </a>
                                    </h3>

                                    <div class="blog-readtime-date">
                                        <?=
                                        /** @noEscape */
                                        $block->getPostInfo($post)
                                        ?>
                                    </div>
                                </article>
                        </div>
                        <?php endforeach; ?>
                    </div>
                </section>
            <?php endforeach; ?>
        <?php endif; ?>

        <?php $authorIds = $block->getAuthorIds(); ?>
        <?php if (!empty($authorIds)) : ?>
            <?php $featuredAuthors = $block->getAuthorsByIds($authorIds); ?>
            <?php if (!empty($featuredAuthors)) : ?>
                <section class="blog-featured-authors">
                    <h2 class="blog-section-heading">
                        <?= $escaper->escapeHtml(__('Featured Authors')) ?>
                    </h2>
                    <?php if ($block->isHyvaTheme()): ?>
                    <div id="featured-authors-splide" class="blog-authors-slider splide">
                        <div class="splide__track">
                            <ul class="splide__list">
                                <?php foreach ($featuredAuthors as $author) : ?>
                                    <li class="blog-author-card splide__slide">
                                        <div class="blog-author-top">
                                        <a class="blog-author-link" href="<?= $escaper->escapeUrl($author->getUrl()) ?>">
                                            <?php if ($author->getImage()) : ?>
                                                <img 
                                                    class="blog-author-avatar"
                                                    src="<?= $escaper->escapeUrl($block->getBlogHelper()->getImageHelper()->resizeImage($author->getImage(), '200x', 'auth')) ?>"
                                                    alt="<?= $escaper->escapeHtmlAttr($author->getName()) ?>"
                                                />
                                            <?php else : ?>
                                                <img 
                                                    class="blog-author-avatar"
                                                    src="<?= $escaper->escapeUrl($block->getDefaultAuthorImage()) ?>"
                                                    alt="<?= $escaper->escapeHtmlAttr($author->getName()) ?>"
                                                />
                                            <?php endif; ?>
                                        </a>
                                            <div class="blog-author-info">
                                                <h3 class="blog-author-name">
                                                    <a class="blog-author-link" href="<?= $escaper->escapeUrl($author->getUrl()) ?>">
                                                        <?= $escaper->escapeHtml($author->getName()) ?>
                                                    </a>
                                                </h3>
                                                <div class="blog-author-social">
                                                    <?php if ($author->getFacebookLink()) : ?>
                                                        <a href="<?= $escaper->escapeUrl($author->getFacebookLink()) ?>" target="_blank" rel="noopener" aria-label="Facebook">
                                                            <i class="fa-brands fa-facebook-f"></i>
                                                        </a>
                                                    <?php endif; ?>
                                                    <?php if ($author->getTwitterLink()) : ?>
                                                        <a href="<?= $escaper->escapeUrl($author->getTwitterLink()) ?>" target="_blank" rel="noopener" aria-label="Twitter">
                                                            <i class="fa-brands fa-x-twitter"></i>
                                                        </a>
                                                    <?php endif; ?>
                                                </div>
                                            </div>
                                        </div>
                                            <?php if ($author->getJobtitle()) : ?>
                                                <p class="blog-author-jobtitle">
                                                    <?= $escaper->escapeHtml($author->getJobtitle()) ?>
                                                </p>
                                            <?php endif; ?>
                                            
                                            <?php if ($author->getShortDescription()) : ?>
                                                <div class="blog-author-description">
                                                    <?= $block->maxShortDescription($author->getShortDescription()) ?>
                                                </div>
                                            <?php endif; ?>
                                                                                    
                                    </li>
                                <?php endforeach; ?>
                            </ul>
                        </div>
                    </div>
                    <?php else: ?>
                    <div class="blog-authors-slider owl-carousel">
                        <?php foreach ($featuredAuthors as $author) : ?>
                            <div class="blog-author-card">
                                <a class="blog-author-link" href="<?= $escaper->escapeUrl($author->getUrl()) ?>">
                                    <?php if ($author->getImage()) : ?>
                                        <img 
                                            class="blog-author-avatar"
                                            src="<?= $escaper->escapeUrl($block->getBlogHelper()->getImageHelper()->resizeImage($author->getImage(), '200x', 'auth')) ?>"
                                            alt="<?= $escaper->escapeHtmlAttr($author->getName()) ?>"
                                        />
                                    <?php else : ?>
                                        <img 
                                            class="blog-author-avatar"
                                            src="<?= $escaper->escapeUrl($block->getDefaultAuthorImage()) ?>"
                                            alt="<?= $escaper->escapeHtmlAttr($author->getName()) ?>"
                                        />
                                    <?php endif; ?>
                                </a>

                                    <h3 class="blog-author-name">
                                        <?= $escaper->escapeHtml($author->getName()) ?>
                                    </h3>
                                    
                                    <?php if ($author->getJobtitle()) : ?>
                                        <p class="blog-author-jobtitle">
                                            <?= $escaper->escapeHtml($author->getJobtitle()) ?>
                                        </p>
                                    <?php endif; ?>
                                    
                                    <?php if ($author->getShortDescription()) : ?>
                                        <p class="blog-author-description">
                                            <?= $block->maxShortDescription($author->getShortDescription()) ?>
                                        </p>
                                    <?php endif; ?>
                                    
                                    <div class="blog-author-social">
                                        <?php if ($author->getFacebookLink()) : ?>
                                            <a href="<?= $escaper->escapeUrl($author->getFacebookLink()) ?>" target="_blank" rel="noopener" aria-label="Facebook">
                                                <i class="fa-brands fa-facebook-f"></i>
                                            </a>
                                        <?php endif; ?>
                                        <?php if ($author->getTwitterLink()) : ?>
                                            <a href="<?= $escaper->escapeUrl($author->getTwitterLink()) ?>" target="_blank" rel="noopener" aria-label="Twitter">
                                                <i class="fa-brands fa-x-twitter"></i>
                                            </a>
                                        <?php endif; ?>
                                    </div>
                            </div>
                        <?php endforeach; ?>
                    </div>
                    <?php endif; ?>
                </section>
                <?php if ($block->isHyvaTheme()): ?>
                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        const splideElement = document.getElementById('featured-authors-splide');
                        if (splideElement) {
                            new Splide('#featured-authors-splide', {
                                type: 'slide',
                                perPage: 2,
                                perMove: 1,
                                gap: '24px',
                                loop: false,
                                pagination: true,
                                arrows: true,
                                breakpoints: {
                                    768: {
                                        perPage: 1,
                                        gap: '16px'
                                    }
                                }
                            }).mount();
                        }
                    });
                </script>
                <?php else: ?>
                <script>
                    require(['jquery', 'owlCarousel'], function($) {
                        $(function() {
                            if ($('.blog-authors-slider').length) {
                                $('.blog-authors-slider').owlCarousel({
                                    loop: true,
                                    margin: 24,
                                    nav: true,
                                    dots: true,
                                    responsive: {
                                        0: {
                                            items: 1
                                        },
                                        768: {
                                            items: 2
                                        }
                                    }
                                });
                            }
                        });
                    });
                </script>
                <?php endif; ?>
            <?php endif; ?>
        <?php endif; ?>

    <?php else : ?>
        <div class="blog-empty-state">
            <?= $escaper->escapeHtml(__('There are no posts at this moment')) ?>
        </div>
    <?php endif; ?>

    <?= $block->getChildHtml('additional'); ?>
</div>
<?php endif; ?>