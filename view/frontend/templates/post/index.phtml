                                                        target="_blank"
                                                        rel="noopener"
                                                        title="<?= $escaper->escapeHtmlAttr($share['label']) ?>">

                                                        <i class="<?= $escaper->escapeHtmlAttr($share['icon_class']) ?>
                                                                <?= $escaper->escapeHtmlAttr($share['icon']) ?>"></i>

                                                    </a>
                                                <?php endif; ?>
                                            <?php endforeach; ?>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <?php endif; ?>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
        <?= $block->getPagerHtml() ?>
    <?php else : ?>
        <?= $escaper->escapeHtml(__('There are no posts at this moment')) ?>
    <?php endif; ?>
    <?= $block->getChildHtml('additional'); ?>
</div>
<style>
    .limiter {
        float: right;
    }
</style>
<?php elseif ($block->getBlogStyle() == '2'): ?>
<div class="post-list-content blog-style2" id="mbblog-list">
