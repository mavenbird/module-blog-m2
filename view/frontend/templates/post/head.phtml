use Magento\Framework\Escaper;

/** @var \Mavenbird\Blog\Block\Post\View $block */
/** @var Escaper $escaper */
$_post = $block->getPost();
?>
<!--Open Graph Meta tags by Mavenbird-->
<meta property="og:url"             content="<?= $escaper->escapeUrl($_post->getUrl()) ?>" />
<meta property="og:title"           content="<?= $escaper->escapeHtml($_post->getName()) ?>" />
<meta property="og:image"           content="<?= $escaper->escapeUrl($block->getImageUrl($_post->getImage())) ?>" />
<meta property="og:description"    content="<?= $escaper->escapeHtml($_post->getShortDescription()) ?>" />
