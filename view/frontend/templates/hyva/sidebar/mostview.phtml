use Mavenbird\Blog\Block\Sidebar\MostView;
use Magento\Framework\Escaper;

/** @var MostView $block */
/** @var Escaper $escaper */
$posts       = $block->getMostViewPosts();
$postsRecent = $block->getRecentPost();
?>
<div class="sidebar-post">
    <div class="product data items" x-data="{ tab: 'popular' }">

        <!-- TAB HEADERS -->
        <div class="blog-tabs-header">
            <button class="tab-btn"
                    :class="{ 'active': tab === 'popular' }"
                    @click="tab = 'popular'">
                <?= $escaper->escapeHtml(__('Popular')) ?>
            </button>

            <button class="tab-btn"
                    :class="{ 'active': tab === 'latest' }"
                    @click="tab = 'latest'">
                <?= $escaper->escapeHtml(__('Latest')) ?>
            </button>
        </div>

        <!-- POPULAR POSTS -->
        <div class="tab-content" x-show="tab === 'popular'" x-cloak>
            <?php foreach ($posts as $post) : ?>
                <div class="list-post-tabs">

                    <div class="post-left">
                        <a href="<?= $escaper->escapeUrl($post->getUrl()) ?>">
                            <img src="<?= $escaper->escapeUrl($block->resizeImage($post->getImage(), '400x')) ?>">
                        </a>
                    </div>

                    <div class="post-right">
                        <a href="<?= $escaper->escapeUrl($post->getUrl()) ?>">
                            <span><?= $escaper->escapeHtml($post->getName()) ?></span>
                        </a>

                        <span class="create-at">
                            <?= $post->getPublishDate()
                                ? $escaper->escapeHtml($block->getDateFormat($post->getPublishDate())) : '' ?>
                        </span>
                    </div>

                </div>
            <?php endforeach; ?>
        </div>


        <!-- LATEST POSTS -->
        <div class="tab-content" x-show="tab === 'latest'" x-cloak>
            <?php foreach ($postsRecent as $post) : ?>
                <div class="list-post-tabs">

                    <div class="post-left">
                        <a href="<?= $escaper->escapeUrl($post->getUrl()) ?>">
                            <img src="<?= $escaper->escapeUrl($block->resizeImage($post->getImage(), '400x')) ?>">
                        </a>
                    </div>

                    <div class="post-right">
                        <a href="<?= $escaper->escapeUrl($post->getUrl()) ?>">
                            <span><?= $escaper->escapeHtml($post->getName()) ?></span>
                        </a>

                        <span class="create-at">
                            <?= $post->getPublishDate()
                                ? $escaper->escapeHtml($block->getDateFormat($post->getPublishDate())) : '' ?>
                        </span>
                    </div>

                </div>
            <?php endforeach; ?>
        </div>

    </div>
</div>