<?php
/**
 * Hyvä Magento 2 Blog Widget Template with Splide Slider
 *
 * @var \Mavenbird\Blog\Block\Widget\Posts $block
 * @var \Magento\Framework\Escaper $escaper
 */
use Mavenbird\Blog\Block\Widget\Posts;
use Magento\Framework\Escaper;

$posts = $block->getCollection();
$blogShowType = $block->getData('blog_show_type') ?? 'grid'; // default to grid
$showPostInfo = $block->showPostInfo();
$showShortDescription = $block->showShortDescription();
$showReadMore = $block->showReadMore();
?>

<!-- Include Splide CSS & JS -->
<?php if ($blogShowType === 'slider'): ?>
<script src="<?= $escaper->escapeUrl($block->getViewFileUrl('Mavenbird_Blog::js/splide.min.js')) ?>" defer></script>
<link rel="stylesheet" type="text/css" href="<?= $block->getViewFileUrl('Mavenbird_Blog::css/splide.min.css') ?>" />
<link rel="stylesheet" type="text/css" href="<?= $block->getViewFileUrl('Mavenbird_Blog::css/hyvawidget-post.css') ?>" />
<?php endif; ?>

<div class="mbblog-widget-post post-list-container <?= $blogShowType === 'slider' ? 'splide-slider-view' : 'grid-view' ?>" style="margin-bottom:50px">
    <!-- Widget Title -->
    <div class="widget-title mb-6">
        <a class="text-2xl font-medium" href="<?= $escaper->escapeUrl($block->getBlogUrl('')) ?>">
            <?= $escaper->escapeHtml($block->getTitle()) ?>
        </a>
    </div>

    <?php if ($blogShowType === 'slider'): ?>
        <!-- Splide Slider -->
        <div id="blogSplide" class="splide">
            <div class="splide__track">
                <ul class="splide__list">
                    <?php foreach ($posts as $post): ?>
                        <li class="splide__slide">
                            <div class="post-item-wraper p-4 border rounded shadow-sm">
                                <?php if ($post->getImage()): ?>
                                    <div class="post-image mb-3">
                                        <a href="<?= $escaper->escapeUrl($post->getUrl()) ?>">
                                            <img class="w-full object-cover rounded"
                                                src="<?= $escaper->escapeUrl($block->resizeImage($post->getImage(),'1000x')) ?>"
                                                alt="<?= $escaper->escapeHtml($post->getName()) ?>" />
                                        </a>
                                    </div>
                                <?php endif; ?>

                                <h2 class="mb-post-title text-lg xl:text-xl font-semibold mb-2">
                                    <a class="hover:text-blue-600"
                                       href="<?= $escaper->escapeUrl($post->getUrl()) ?>"
                                       title="<?= $escaper->escapeHtmlAttr($post->getName()) ?>">
                                        <?= $escaper->escapeHtml($post->getName()) ?>
                                    </a>
                                </h2>

                                <?php if ($showPostInfo): ?>
                                    <div class="mb-post-info text-sm text-gray-500 mb-2">
                                        <?= /** @noEscape */ $block->getPostInfo($post) ?>
                                    </div>
                                <?php endif; ?>

                                <?php if ($showShortDescription): ?>
                                    <div class="post-short-description text-gray-700 mb-2">
                                        <p><?= /** @noEscape */ $post->getShortDescription(true) ?></p>
                                    </div>
                                <?php endif; ?>

                                <?php if ($showReadMore): ?>
                                    <div class="mb-post-meta-info text-left">
                                        <a class="mb-read-more hover:underline py-2.5 font-medium mt-4 rounded-lg text-primary"
                                           href="<?= $escaper->escapeUrl($post->getUrl()) ?>"
                                           title="<?= $escaper->escapeHtmlAttr(__('Read More')) ?>">
                                            <?= $escaper->escapeHtml(__('Read more')) ?>
                                        </a>
                                    </div>
                                <?php endif; ?>
                            </div>
                        </li>
                    <?php endforeach; ?>
                </ul>
            </div>
        </div>

        <!-- Initialize Splide -->
        <script defer>
        document.addEventListener('DOMContentLoaded', function () {
            const splideEl = document.getElementById('blogSplide');
            if (splideEl) {
                new Splide('#blogSplide', {
                    type: 'loop',
                    perPage: 3,
                    perMove: 1,
                    gap: '20px',
                    autoplay: false,
                    breakpoints: {
                        1024: { perPage: 3 },
                        991: { perPage: 2 },
                        480: { perPage: 1 }
                    }
                }).mount();
            }
        });
        </script>

    <?php else: ?>
        <!-- Grid View -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <?php foreach ($posts as $post): ?>
                <div class="post-list-item p-4 border border-[#ddd] bg-white rounded shadow-sm">
                    <?php if ($post->getImage()): ?>
                        <div class="post-image mb-3">
                            <a href="<?= $escaper->escapeUrl($post->getUrl()) ?>">
                                <img class="w-full h-56 object-cover rounded"
                                     src="<?= $escaper->escapeUrl($block->resizeImage($post->getImage(),'400x')) ?>"
                                     alt="<?= $escaper->escapeHtml($post->getName()) ?>" />
                            </a>
                        </div>
                    <?php endif; ?>

                    <h2 class="mb-post-title text-lg xl:text-xl font-semibold mb-2">
                            <a class="hover:text-blue-600"
                               href="<?= $escaper->escapeUrl($post->getUrl()) ?>"
                               title="<?= $escaper->escapeHtmlAttr($post->getName()) ?>">
                                <?= $escaper->escapeHtml($post->getName()) ?>
                            </a>
                        </h2>

                        <?php if ($showPostInfo): ?>
                            <div class="mb-post-info text-sm text-gray-500 mb-2">
                                <?= /** @noEscape */ $block->getPostInfo($post) ?>
                            </div>
                        <?php endif; ?>

                        <?php if ($showShortDescription): ?>
                            <div class="post-short-description text-gray-700 mb-2">
                                <p><?= /** @noEscape */ $post->getShortDescription(true) ?></p>
                            </div>
                        <?php endif; ?>

                        <?php if ($showReadMore): ?>
                            <div class="mb-post-meta-info text-right">
                                <a class="mb-read-more px-6 py-2.5  font-medium mt-4 rounded-lg hover:underline"
                                   href="<?= $escaper->escapeUrl($post->getUrl()) ?>"
                                   title="<?= $escaper->escapeHtmlAttr(__('Read More')) ?>">
                                    <?= $escaper->escapeHtml(__('Read more')) ?>
                                </a>
                            </div>
                        <?php endif; ?>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>