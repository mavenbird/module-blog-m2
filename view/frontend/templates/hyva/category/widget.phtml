use Mavenbird\Blog\Block\Category\Widget;
use Magento\Framework\Escaper;

/** @var Widget $block */
/** @var Escaper $escaper */
$tree = $block->getTree();
$accordion = $block->isCategoryAccordionEnabled();
$isSidebarOneColumn = $block->isCategorySidebarOneColumn();
if ($tree) : ?>
<div class="sidebar-info sidebar-categories">
    <div class="block-title categories-title">
        <p class="block-title-sidebar-heading" role="heading" aria-label="2">
            <strong><?= $escaper->escapeHtml(__('Categories')) ?></strong>
        </p>
    </div>
    <div class="categories-item-list">
<?= $block->getCategoryTreeHtml($tree, $accordion) ?>    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {

    const isSidebarOneColumn = <?= $isSidebarOneColumn ? 'true' : 'false' ?>;

    const categoryList = document.querySelector('.categories-item-list');
    const categoryTitle = document.querySelector('.categories-title');

    /* 1 column sidebar toggle */
    if (isSidebarOneColumn && categoryList && categoryTitle) {

        // hide by default
        categoryList.style.display = 'none';

        categoryTitle.addEventListener('click', function () {

            const isOpen = categoryList.style.display === 'block';
            categoryList.style.display = isOpen ? 'none' : 'block';

        });
    }

    /* category children toggle */
    document.querySelectorAll('.mb-category-toggle').forEach(function(toggle){

        toggle.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();

            const parentLi = this.closest('li');
            const children = parentLi.querySelector(':scope > .category-children');

            if (!children) return;

            const isOpen = children.style.display === 'block';

            children.style.display = isOpen ? 'none' : 'block';
            this.innerHTML = isOpen 
                ? '<i class="fa-solid fa-plus"></i>' 
                : '<i class="fa-solid fa-minus"></i>';
        });

    });

});
</script>
<?php endif; ?>