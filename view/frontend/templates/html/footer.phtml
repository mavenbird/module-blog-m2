use Mavenbird\Blog\Block\Html\Footer;
use Magento\Framework\Escaper;

/** @var Footer $block */
/** @var Escaper $escaper */
$helper = $block->getHelperData();
?>
<?php if ($helper->isEnabled()) : ?>
    <?php if ($helper->isFooterEnabled()) : ?>
        <li>
            <a <?= /** @noEscape */ $block->getLinkAttributes() ?>>
                <?= $escaper->escapeHtml($block->getLabel()); ?>
                <?= ($block->getCounter()) ? '<span>' . $escaper->escapeHtml($block->getCounter()) . '</span>' : ''; ?>
            </a>
        </li>
    <?php endif; ?>
    <?= $block->getChildHtml('mb_blog_footer_add') ?>
<?php endif; ?>