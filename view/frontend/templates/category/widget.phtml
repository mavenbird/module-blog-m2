use Mavenbird\Blog\Block\Category\Widget;
use Magento\Framework\Escaper;

/** @var Widget $block */
/** @var Escaper $escaper */
/** @var \Mavenbird\Blog\Block\Category\Widget $block */
$tree = $block->getTree();
$accordion = $block->isCategoryAccordionEnabled();
$isSidebarOneColumn = $block->isCategorySidebarOneColumn();
// echo $isSidebarOneColumn;
?>

<?php if ($tree) : ?>
<div class="sidebar-info sidebar-categories">
    <div class="block-title categories-title">
        <strong class="block-title-sidebar-heading" role="heading" aria-label="2">
            <?= $escaper->escapeHtml(__('Categories')) ?>
        </strong>
    </div>
    <div class="categories-items-list" 
         data-mb-accordion="<?= $accordion ? 1 : 0 ?>">
        <?= $block->getCategoryTreeHtmlLuma($tree, $accordion) ?>
    </div>
</div>

<?php if ($accordion || $isSidebarOneColumn) : ?>
<script type="text/javascript">
require(['jquery', 'categoryTree'], function ($, categoryTree) {

    var element = document.querySelector('.categories-items-list');

    if (element) {
        categoryTree({}, element);
    }

    <?php if ($isSidebarOneColumn) : ?>
    var $categoryList = $('.sidebar-categories .categories-items-list');
    // hide by default
    $categoryList.hide();
    // toggle on title click
    $('.sidebar-categories .categories-title').on('click', function () {
        $categoryList.slideToggle();
    });
    <?php endif; ?>

});
</script>
<?php endif; ?>

<?php endif; ?>