use Mavenbird\Blog\Block\Category\Widget;
use Magento\Framework\Escaper;

/** @var Widget $block */
/** @var Escaper $escaper */
/** @var \Mavenbird\Blog\Block\Category\Widget $block */
$tree = $block->getTree();
$accordion = $block->isCategoryAccordionEnabled();
?>

<?php if ($tree) : ?>
<div class="sidebar-info">
    <div class="block-title sidebar-categories">
        <strong class="block-title-sidebar-heading" role="heading" aria-label="2">
            <?= $escaper->escapeHtml(__('Categories')) ?>
        </strong>
    </div>
    <div class="categories-items-list" 
         data-mb-accordion="<?= $accordion ? 1 : 0 ?>">
        <?= $block->getCategoryTreeHtml($tree, $accordion) ?>
    </div>
</div>

<?php if ($accordion) : ?>
<script type="text/javascript">
    require(['Mavenbird_Blog/js/categorytree'], function (categoryTree) {
        // Initialize JS accordion for this element
        var element = document.querySelector('.categories-items-list');
        categoryTree({}, element);
    });
</script>
<?php endif; ?>

<?php endif; ?>