<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Mavenbird_Core::css/grid-mavenbird.css"/>
        <css src="Mavenbird_Core::css/font-awesome.min.css"/>
        <css src="Mavenbird_Blog::css/hyvaBlog.css"/>

        <script src="Mavenbird_Blog::js/splide.min.js" />
        <css src="Mavenbird_Blog::css/splide.min.css" />
    </head>
    <body>
        <referenceContainer name="columns">
            <container name="div.sidebar.main" htmlTag="div" htmlClass="sidebar sidebar-main" before="main">
                <container name="blog.sidebar.main" as="sidebar_main" label="Sidebar Main">
                    <block class="Mavenbird\Blog\Block\Sidebar\Search" name="mbblog.sidebar.search" template="Mavenbird_Blog::hyva/sidebar/search.phtml" ifconfig="blog/sidebar/search/enable_search"/>
                    <block class="Mavenbird\Blog\Block\Sidebar\MostView" name="mbblog.sidebar.mostview" template="Mavenbird_Blog::hyva/sidebar/mostview.phtml" ifconfig="blog/sidebar/recent_post/enable_widget"/>
                    <block class="Mavenbird\Blog\Block\Category\Widget" name="mbblog.sidebar.category" template="Mavenbird_Blog::hyva/category/widget.phtml"/>
                    <block class="Mavenbird\Blog\Block\MonthlyArchive\Widget" name="mbblog.sidebar.monthly" template="Mavenbird_Blog::monthly/widget.phtml"/>
                    <block class="Mavenbird\Blog\Block\Topic\Widget" name="mbblog.sidebar.topic" template="Mavenbird_Blog::topic/widget.phtml"/>
                    <block class="Mavenbird\Blog\Block\Tag\Widget" name="mbblog.sidebar.tag" template="Mavenbird_Blog::tag/widget.phtml"/>
                    <block class="Magento\Framework\View\Element\Template" name="mbblog.sidebar.nav" template="Mavenbird_Blog::nav/post-content-nav.phtml" />
                </container>
            </container>
        </referenceContainer>

        <referenceBlock name="mbblog.design">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Mavenbird_Blog::hyva/design.phtml</argument>
            </action>
        </referenceBlock>

    </body>
</page>
