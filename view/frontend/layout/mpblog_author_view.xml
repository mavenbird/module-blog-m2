<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="mpblog_design"/>
    <body>
        <referenceContainer name="content">
            <block class="Mavenbird\Blog\Block\Author\Listpost" name="mpblog.post.list" template="Mavenbird_Blog::post/list.phtml"/>
        </referenceContainer>
        <referenceContainer name="blog.sidebar.main">
            <block class="Mavenbird\Blog\Block\Author\Widget" after="mpblog.sidebar.mostview" name="mpblog.view.sidebar.author" template="Mavenbird_Blog::author/widget.phtml"/>
        </referenceContainer>
        <referenceBlock name="mpblog.sidebar.category" remove="true"/>
        <referenceBlock name="mpblog.sidebar.monthly" remove="true"/>
        <referenceBlock name="mpblog.sidebar.topic" remove="true"/>
        <referenceBlock name="mpblog.sidebar.tag" remove="true"/>
    </body>
</page>
