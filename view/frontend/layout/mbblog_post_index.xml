<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="mbblog_design"/>
    <body>
        <referenceContainer name="content">
            <block class="Mavenbird\Blog\Block\Post\Listpost" name="mbblog.post.list" as="mbblog_post" template="Mavenbird_Blog::post/list.phtml"/>
            <block class="Magento\Framework\View\Element\Template" name="mbblog.copy.right" after="-" template="Mavenbird_Blog::html/copyright.phtml"/>
        </referenceContainer>
    </body>
</page>

