<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Mavenbird_Core::css/grid-mavenbird.css"/>
        <css src="Mavenbird_Core::css/font-awesome.min.css"/>
        <css src="Mavenbird_Blog::css/owl.carousel.css"/>
        <css src="Mavenbird_Blog::css/owl.theme.css"/>
    </head>
    <body>
        <referenceContainer name="columns">
            <container name="div.sidebar.main" htmlTag="div" htmlClass="sidebar sidebar-main" after="main">
                <container name="blog.sidebar.main" as="sidebar_main" label="Sidebar Main">
                    <block class="Mavenbird\Blog\Block\Sidebar\Search" name="mbblog.sidebar.search" template="Mavenbird_Blog::sidebar/search.phtml" ifconfig="blog/sidebar/search/enable_search"/>
                    <block class="Mavenbird\Blog\Block\Sidebar\MostView" name="mbblog.sidebar.mostview" template="Mavenbird_Blog::sidebar/mostview.phtml" ifconfig="blog/sidebar/recent_post/enable_widget"/>
                    <block class="Mavenbird\Blog\Block\Category\Widget" name="mbblog.sidebar.category" template="Mavenbird_Blog::category/widget.phtml"/>
                    <block class="Mavenbird\Blog\Block\MonthlyArchive\Widget" name="mbblog.sidebar.monthly" template="Mavenbird_Blog::monthly/widget.phtml"/>
                    <block class="Mavenbird\Blog\Block\Topic\Widget" name="mbblog.sidebar.topic" template="Mavenbird_Blog::topic/widget.phtml"/>
                    <block class="Mavenbird\Blog\Block\Tag\Widget" name="mbblog.sidebar.tag" template="Mavenbird_Blog::tag/widget.phtml"/>
                </container>
            </container>
        </referenceContainer>
        <referenceBlock name="head.additional">
            <block class="Mavenbird\Blog\Block\Design" name="mbblog.design" template="Mavenbird_Blog::design.phtml"/>
        </referenceBlock>
    </body>
</page>
