<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mavenbird_blog_post_form.post_form_data_source</item>
            <item name="deps" xsi:type="string">mavenbird_blog_post_form.post_form_data_source</item>
            <item name="namespace" xsi:type="string">mavenbird_blog_post_form</item>
        </item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">Mavenbird\Blog\Block\Adminhtml\Post\Edit\BackButton</item>
            <item name="duplicate" xsi:type="string">Mavenbird\Blog\Block\Adminhtml\Post\Edit\DuplicateButton</item>
            <item name="preview" xsi:type="string">Mavenbird\Blog\Block\Adminhtml\Post\Edit\PreviewButton</item>
            <item name="delete" xsi:type="string">Mavenbird\Blog\Block\Adminhtml\Post\Edit\DeleteButton</item>
            <item name="save_and_continue" xsi:type="string">Mavenbird\Blog\Block\Adminhtml\Post\Edit\SaveAndContinueButton</item>
            <item name="save" xsi:type="string">Mavenbird\Blog\Block\Adminhtml\Post\Edit\SaveButton</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Post</item>
    </argument>

    <!-- TABS LAYOUT — this is the key to get tab UI -->
    <settings>
        <dataScope>post</dataScope>
        <namespace>mavenbird_blog_post_form</namespace>
        <deps>
            <dep>mavenbird_blog_post_form.post_form_data_source</dep>
        </deps>
        <layout>
            <navContainerName>left</navContainerName>
            <type>tabs</type>
        </layout>
    </settings>

    <dataSource name="post_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Mavenbird\Blog\Ui\DataProvider\Blog\Form\NewPostDataProvider</argument>
            <argument name="name" xsi:type="string">post_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">post_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" xsi:type="url" path="mavenbird_blog/post/save"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>

    <!-- ===================== TAB 1: POST ===================== -->
    <fieldset name="post">
        <settings>
            <label translate="true">Post</label>
        </settings>

        <field name="post_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">post_id</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="visible" xsi:type="boolean">false</item>
                </item>
            </argument>
        </field>

        <field name="name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Name</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">name</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="sortOrder" xsi:type="number">10</item>
                    <item name="required" xsi:type="boolean">true</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>

        <field name="url_key">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">URL Key</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">url_key</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
            </argument>
        </field>

        <field name="author_id">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Mavenbird\Blog\Model\Config\Source\Author</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Author</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">author_id</item>
                    <item name="dataType" xsi:type="string">number</item>
                    <item name="sortOrder" xsi:type="number">30</item>
                    <item name="required" xsi:type="boolean">true</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>

        <field name="enabled">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Mavenbird\Blog\Model\Config\Source\AuthorStatus</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Status</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">enabled</item>
                    <item name="dataType" xsi:type="string">number</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">40</item>
                </item>
            </argument>
        </field>

        <field name="short_description">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Short Description</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">textarea</item>
                    <item name="dataScope" xsi:type="string">short_description</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">50</item>
                </item>
            </argument>
        </field>

        <!-- PAGE BUILDER FIELD -->
        <field name="post_content">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">wysiwyg</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="label" xsi:type="string" translate="true">Content</item>
                    <item name="template" xsi:type="string">ui/form/field</item>
                    <item name="wysiwyg" xsi:type="boolean">true</item>
                    <item name="dataScope" xsi:type="string">post_content</item>
                    <item name="sortOrder" xsi:type="number">60</item>
                    <item name="rows" xsi:type="number">8</item>
                    <item name="config" xsi:type="array">
                        <item name="wysiwygConfigData" xsi:type="array">
                            <item name="add_variables" xsi:type="boolean">true</item>
                            <item name="add_widgets" xsi:type="boolean">true</item>
                            <item name="add_images" xsi:type="boolean">true</item>
                            <item name="add_directives" xsi:type="boolean">true</item>
                            <item name="use_container" xsi:type="boolean">true</item>
                            <item name="is_pagebuilder_enabled" xsi:type="boolean">false</item>
                        </item>
                    </item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">false</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="image">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="label" xsi:type="string" translate="true">Image</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="formElement" xsi:type="string">imageUploader</item>
                    <item name="elementTmpl" xsi:type="string">ui/form/element/uploader/uploader</item>
                    <item name="previewTmpl" xsi:type="string">Mavenbird_Blog/image-preview</item>
                    <item name="required" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="number">60</item>
                    <item name="uploaderConfig" xsi:type="array">
                        <item name="url" xsi:type="url" path="mavenbird_blog/post/upload"/>
                    </item>
                    <item name="dataScope" xsi:type="string">image</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">false</item>
                    </item>
                    <item name="allowedExtensions" xsi:type="string">jpg jpeg gif png</item>
                    <item name="maxFileSize" xsi:type="number">2097152</item>
                </item>
            </argument>
        </field>
        <field name="store_ids">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Cms\Ui\Component\Listing\Column\Cms\Options</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Store Views</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">multiselect</item>
                    <item name="dataScope" xsi:type="string">store_ids</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">70</item>
                    <item name="default" xsi:type="array">
                        <item name="0" xsi:type="number">0</item>
                    </item>
                </item>
            </argument>
        </field>

        <field name="categories_ids">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Mavenbird\Blog\Ui\Component\Blog\Form\Categories\Options</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Categories</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Mavenbird_Blog/js/components/new-category</item>
                    <item name="elementTmpl" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                    <item name="dataScope" xsi:type="string">categories_ids</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">75</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="chipsEnabled" xsi:type="boolean">true</item>
                    <item name="levelsVisibility" xsi:type="number">1</item>
                    <item name="multiple" xsi:type="boolean">true</item>
                </item>
            </argument>
        </field>

        <field name="topics_ids">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Mavenbird\Blog\Ui\Component\Blog\Form\Topics\Options</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Topics</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Mavenbird_Blog/js/components/new-category</item>
                    <item name="elementTmpl" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                    <item name="dataScope" xsi:type="string">topics_ids</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">76</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="chipsEnabled" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">true</item>
                </item>
            </argument>
        </field>

        <field name="tags_ids">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Mavenbird\Blog\Ui\Component\Blog\Form\Tags\Options</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Tags</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Mavenbird_Blog/js/components/new-category</item>
                    <item name="elementTmpl" xsi:type="string">ui/grid/filters/elements/ui-select</item>
                    <item name="dataScope" xsi:type="string">tags_ids</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">77</item>
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="disableLabel" xsi:type="boolean">true</item>
                    <item name="chipsEnabled" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">true</item>
                </item>
            </argument>
        </field>

        <field name="in_rss">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Config\Model\Config\Source\Yesno</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">In RSS</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">in_rss</item>
                    <item name="dataType" xsi:type="string">number</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">80</item>
                </item>
            </argument>
        </field>

        <field name="allow_comment">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Config\Model\Config\Source\Yesno</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Allow Comment</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">allow_comment</item>
                    <item name="dataType" xsi:type="string">number</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">90</item>
                </item>
            </argument>
        </field>

        <field name="publish_date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Publish Date</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">date</item>
                    <item name="dataScope" xsi:type="string">publish_date</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="sortOrder" xsi:type="number">100</item>
                    <item name="dateFormat" xsi:type="string">yyyy-MM-dd</item>
                    <item name="timeFormat" xsi:type="string">HH:mm:ss</item>
                    <item name="showsTime" xsi:type="boolean">true</item>
                    <item name="source" xsi:type="string">post</item>
                </item>
            </argument>
        </field>

        <field name="meta_title">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Meta Title</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataScope" xsi:type="string">meta_title</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">110</item>
                </item>
            </argument>
        </field>

        <field name="meta_description">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Meta Description</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">textarea</item>
                    <item name="dataScope" xsi:type="string">meta_description</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">120</item>
                </item>
            </argument>
        </field>

        <field name="meta_keywords">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Meta Keywords</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">textarea</item>
                    <item name="dataScope" xsi:type="string">meta_keywords</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">130</item>
                </item>
            </argument>
        </field>

        <field name="meta_robots">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Config\Model\Config\Source\Design\Robots</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Meta Robots</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">meta_robots</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">140</item>
                </item>
            </argument>
        </field>

        <field name="layout">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Cms\Model\Page\Source\PageLayout</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Layout</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">layout</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">150</item>
                </item>
            </argument>
        </field>

        <field name="static_block_identifier">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Mavenbird\Blog\Model\Config\Source\ListOfStaticBlock</item>
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Static Block Identifier</item>
                    <item name="componentType" xsi:type="string">field</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="dataScope" xsi:type="string">static_block_identifier</item>
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="sortOrder" xsi:type="number">160</item>
                </item>
            </argument>
        </field>
        
    </fieldset>

    <!-- ===================== TAB 2: PRODUCT ===================== -->
    <fieldset name="product_tab">
        <settings>
            <label translate="true">Products</label>
        </settings>

        <htmlContent name="mavenbird_blog_post_product_grid">
            <block class="Mavenbird\Blog\Block\Adminhtml\Post\Edit\Tab\Product" name="mavenbird_blog_post_edit_tab_product"/>
        </htmlContent>

    </fieldset>

    <!-- ===================== TAB 3: HISTORY ===================== -->
    <fieldset name="history_tab">
        <settings>
            <label translate="true">History</label>
        </settings>

        <htmlContent name="mavenbird_blog_post_history_grid">
        <block class="Mavenbird\Blog\Block\Adminhtml\Post\Edit\Tab\History"
               name="mavenbird_blog_post_edit_tab_history"/>
    </htmlContent>

    </fieldset>

</form>