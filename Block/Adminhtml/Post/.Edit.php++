<?php

namespace Mavenbird\Blog\Block\Adminhtml\Post;

use Magento\Backend\Block\Widget\Context;
use Magento\Backend\Block\Widget\Form\Container;
use Magento\Framework\Registry;
use Mavenbird\Blog\Model\Post;

/**
 * Class Edit
 * @package Mavenbird\Blog\Block\Adminhtml\Post
 */
class Edit extends Container
{
    /**
     * Core registry
     *
     * @var Registry
     */
    public $coreRegistry;

    /**
     * @param Registry $coreRegistry
     * @param Context $context
     * @param array $data
     */
    public function __construct(
        Registry $coreRegistry,
        Context $context,
        array $data = []
    ) {
        $this->coreRegistry = $coreRegistry;
        parent::__construct($context, $data);
    }

    /**
     * Initialize Post edit block
     *
     * @return void
     */
    protected function _construct()
    {
        $this->_blockGroup = 'Mavenbird_Blog';
        $this->_controller = 'adminhtml_post';

        parent::_construct();

        if (!$this->getRequest()->getParam('history')) {
            $post = $this->coreRegistry->registry('mavenbird_blog_post');

            $this->buttonList->remove('save');
            $this->buttonList->add(
                'save',
                [
                    'label' => __('Save'),
                    'class' => 'save primary',
                    'onclick' => $this->getUiSaveJs(),
                    'class_name' => \Magento\Ui\Component\Control\Container::SPLIT_BUTTON,
                    'options' => $this->getOptions($post),
                ],
                -100
            );

            $this->buttonList->add(
                'save-and-continue',
                [
                    'label' => __('Save and Continue Edit'),
                    'class' => 'save',
                    'onclick' => $this->getUiSaveJs('continue'),
                ],
                -100
            );

            if ($post->getId()) {
                $this->buttonList->add(
                    'preview',
                    [
                        'label' => __('Preview'),
                        'class' => 'preview',
                        'onclick' => sprintf(
                            "window.open('%s', '_blank')",
                            $this->getPreviewUrl($post)
                        ),
                    ],
                    -102
                );
            }

            if ($post->getId() && !$this->_request->getParam('duplicate')) {
                $this->buttonList->add(
                    'duplicate',
                    [
                        'label' => __('Duplicate'),
                        'class' => 'duplicate',
                        'onclick' => sprintf("location.href = '%s';", $this->getDuplicateUrl()),
                    ],
                    -101
                );
            } else {
                $this->buttonList->remove('delete');
            }
        }
    }

    /**
     * Retrieve text for header element depending on loaded Post
     *
     * @return string
     */
    public function getHeaderText()
    {
        /** @var Post $post */
        $post = $this->coreRegistry->registry('mavenbird_blog_post');

        if ($this->getRequest()->getParam('history')) {
            return __("Edit History Post '%1'", $this->escapeHtml($post->getName()));
        }

        if ($post->getId() && $post->getDuplicate()) {
            return __("Edit Post '%1'", $this->escapeHtml($post->getName()));
        }

        return __('New Post');
    }

    /**
     * Get form action URL
     *
     * @return string
     */
    public function getFormActionUrl()
    {
        /** @var Post $post */
        $post = $this->coreRegistry->registry('mavenbird_blog_post');

        if ($post->getId()) {
            if ($post->getDuplicate()) {
                $ar = [];
            } else {
                $ar = ['id' => $post->getId()];
            }

            if ($this->getRequest()->getParam('history')) {
                $ar['post_id'] = $this->getRequest()->getParam('post_id');
            }

            return $this->getUrl('*/*/save', $ar);
        }

        return parent::getFormActionUrl();
    }

    /**
     * @return string
     */
    protected function getDuplicateUrl()
    {
        $post = $this->coreRegistry->registry('mavenbird_blog_post');

        return $this->getUrl('*/*/duplicate', ['id' => $post->getId(), 'duplicate' => true]);
    }

    /**
     * Build split-button options.
     *
     * @param Post $post
     * @return array
     */
    protected function getOptions($post)
    {
        return [
            [
                'id_hard' => 'save_and_draft',
                'label' => __('Save as Draft'),
                'onclick' => $this->getUiSaveJs('draft'),
            ],
            [
            'id_hard' => 'save_and_add_history',
            'label' => __('Save & Add History'),
            'onclick' => $this->getUiSaveJs('add'),
            ],
        ];
    }

    /**
     * @return string
     */
    protected function getSaveDraftUrl()
    {
        return $this->getUrl('*/*/save', ['action' => 'draft']);
    }

    /**
     * @return string
     */
    protected function getSaveAddHistoryUrl()
    {
        return $this->getUrl('*/*/save', ['action' => 'add']);
    }

    /**
     * Build resilient submit JS for split-button options.
     *
     * @param string|null $action
     * @return string
     */
    protected function getSubmitJs($action = null)
    {
        $action = $action ?? '';

        return "var f=document.getElementById('mavenbird_blog_post_form')||"
            . "document.getElementById('edit_form')||document.querySelector('form');"
            . "if(!f){return false;}"
            . "var i=f.querySelector('input[name=\"action\"]');"
            . "if(!i){i=document.createElement('input');i.type='hidden';i.name='action';f.appendChild(i);}"
            . "i.value='" . $this->escapeJs($action) . "';"
            . "if(window.jQuery){window.jQuery(f).trigger('submit');}else{f.submit();}"
            . "return false;";
    }

    /**
     * Save via UI component directly to avoid button adapter conflicts.
     *
     * @param string|null $action
     * @return string
     */
    protected function getUiSaveJs($action = null)
    {
        $action = (string)($action ?? '');
        $action = $this->escapeJs($action);

        if ($action === 'continue') {
            return "require(['uiRegistry'], function (registry) {"
                . "var c = registry.get('mavenbird_blog_post_form.mavenbird_blog_post_form');"
                . "if (c && typeof c.save === 'function') { c.save(false, {}); }"
                . "}); return false;";
        }

        return "require(['uiRegistry'], function (registry) {"
            . "var c = registry.get('mavenbird_blog_post_form.mavenbird_blog_post_form');"
            . "if (c && typeof c.save === 'function') { c.save(true, {action: '" . $action . "'}); }"
            . "}); return false;";
    }

    /**
     * @param Post $post
     * @return string
     */
    protected function getPreviewUrl($post)
    {
        $store = $this->_storeManager->getStore();

        return $store->getUrl(
            'mbblog/post/preview',
            ['id' => $post->getId(), '_secure' => true]
        );
    }
}

